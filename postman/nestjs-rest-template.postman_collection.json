{
  "info": {
    "name": "nestjs-rest-template",
    "description": "REST API for nestjs-rest-template.\n\nRun the whole collection in order (Collection Runner): **Auth → Login** stores `accessToken`, and **Users → Get users** stores `userId` for the requests after it.\n\nDefault values match the local `.env` (`ADMIN_EMAIL` / `ADMIN_PASSWORD`) and the default port 3000.\n\nThe **Registration** folder creates a new `postman-<timestamp>@example.com` user on every run.\n\nThe same API is documented in Swagger UI at `{{baseUrl}}/docs`; `swagger/openapi.json` in the repo can also be imported into Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@gmail.com"
    },
    {
      "key": "adminPassword",
      "value": "@dm1nP@ssL0CAL"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "registerEmail",
      "value": ""
    },
    {
      "key": "registerEmailUpper",
      "value": ""
    },
    {
      "key": "registerPassword",
      "value": "Str0ngPass!"
    },
    {
      "key": "verificationToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns Hello World!', () => pm.expect(pm.response.text()).to.eql('Hello World!'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a JWT access token', () => {",
                  "    pm.expect(body.accessToken).to.be.a('string');",
                  "    pm.expect(body.accessToken.split('.')).to.have.lengthOf(3);",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Returns generic credentials error', () => {",
                  "    pm.expect(pm.response.json().message).to.eql('Email or password is incorrect');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - unknown email",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"any-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Does not reveal whether the email exists', () => {",
                  "    pm.expect(pm.response.json().message).to.eql('Email or password is incorrect');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registration",
      "description": "Register → (verify email) → login.\n\nThe verification link is written to the API log by `MailService`. Copy the `token` from it into the `verificationToken` collection variable to run **Verify email** and **Login after verification**; without it those tests are skipped.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"phoneNumber\": \"+994501234567\",\n  \"dateOfBirth\": \"1995-04-12\",\n  \"gender\": \"FEMALE\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registerEmail', `postman-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the new unverified account', () => {",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('registerEmail'));",
                  "    pm.expect(body.emailVerified).to.eql(false);",
                  "});",
                  "pm.test('Does not return the password', () => pm.expect(body).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - duplicate email (different case)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"{{registerEmailUpper}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"phoneNumber\": \"+994501234567\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registerEmailUpper', pm.collectionVariables.get('registerEmail').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Explains the conflict', () => pm.expect(pm.response.json().message).to.eql('An account with this email already exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - invalid input",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Doe\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"phoneNumber\": \"12345\",\n  \"gender\": \"OTHER\",\n  \"isAdmin\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "const messages = pm.response.json().message;",
                  "pm.test('Reports every invalid field', () => {",
                  "    pm.expect(messages).to.include('firstName should not be empty');",
                  "    pm.expect(messages).to.include('email must be an email');",
                  "    pm.expect(messages).to.include('password must be longer than or equal to 8 characters');",
                  "    pm.expect(messages).to.include('phoneNumber must be in international format, e.g. +994501234567');",
                  "    pm.expect(messages).to.include('gender must be one of the following values: MALE, FEMALE');",
                  "});",
                  "pm.test('Rejects unknown fields', () => pm.expect(messages).to.include('property isAdmin should not exist'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - email not verified",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Asks to verify the email', () => pm.expect(pm.response.json().message).to.eql('Email is not verified'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email - access token is rejected",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{accessToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Rejects tokens issued for another purpose', () => pm.expect(pm.response.json().message).to.eql('Token is invalid or has expired'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email - malformed token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"not-a-jwt\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('verificationToken')) {",
                  "    pm.test.skip('Set verificationToken from the verification email in the API log', () => {});",
                  "} else {",
                  "    pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Email is verified', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login after verification",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('verificationToken')) {",
                  "    pm.test.skip('Runs after Verify email', () => {});",
                  "} else {",
                  "    pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "    pm.test('Returns an access token', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "pm.test('Returns sent: true', () => pm.expect(pm.response.json().sent).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification - unknown email",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));",
                  "pm.test('Same response as a registered email', () => pm.expect(pm.response.json().sent).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a connection', () => {",
                  "    pm.expect(body.totalCount).to.be.a('number');",
                  "    pm.expect(body.edges).to.be.an('array').with.lengthOf(body.totalCount);",
                  "    pm.expect(body.pageInfo).to.include.keys('page', 'totalPages', 'hasNextPage', 'hasPreviousPage');",
                  "});",
                  "pm.test('Contains the admin user', () => {",
                  "    const emails = body.edges.map((e) => e.node.email);",
                  "    pm.expect(emails).to.include(pm.collectionVariables.get('adminEmail'));",
                  "});",
                  "const admin = body.edges.find((e) => e.node.email === pm.collectionVariables.get('adminEmail'));",
                  "if (admin) pm.collectionVariables.set('userId', admin.node.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get users - no token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get users - invalid token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid.jwt.token",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test('Returns the requested user', () => {",
                  "    pm.expect(user.id).to.eql(pm.collectionVariables.get('userId'));",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get('adminEmail'));",
                  "});",
                  "pm.test('Includes role and details', () => {",
                  "    pm.expect(user.role.name).to.eql('admin');",
                  "    pm.expect(user.details).to.be.an('object');",
                  "});",
                  "pm.test('Does not expose the password', () => pm.expect(user).to.not.have.property('password'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Get roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the seeded roles', () => {",
                  "    const names = body.edges.map((e) => e.node.name);",
                  "    pm.expect(names).to.include.members(['admin', 'member']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
