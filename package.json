{
  "name": "nestjs-rest-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:local": "dotenv nodemon --exec ts-node src/main.ts",
    "run:seeders": "ts-node -r tsconfig-paths/register src/modules/db/services/seeder.service.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "swagger:generate": "nest build -p tsconfig.swagger.json && node dist-swagger/generate-swagger",
    "postman:sync": "node scripts/postman-sync.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "npm run build && npx typeorm -d dist/modules/db/postgres-connection-options.js",
    "migration:generate": "dotenv -- npm run typeorm -- migration:generate src/modules/db/migrations/mg",
    "migration:run": "dotenv -- npm run typeorm -- migration:run",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/static": "^9",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/passport": "^11",
    "@nestjs/platform-fastify": "^11",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11",
    "bcryptjs": "^3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cli-color": "^2",
    "dotenv": "^17",
    "jsonwebtoken": "^9",
    "module-alias": "^2.3.4",
    "nest-winston": "^2",
    "nodemailer": "^10.0.13",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "pg": "^8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7",
    "socket.io": "^4",
    "typeorm": "^0.3.31",
    "typeorm-transactional": "^0.5.0",
    "winston": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/cli-color": "^2",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/passport-jwt": "^4",
    "@types/supertest": "^7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30",
    "lint-staged": "^17.6.0",
    "nodemon": "^3",
    "prettier": "^3",
    "source-map-support": "^0.5",
    "supertest": "^7",
    "ts-jest": "^29.4",
    "ts-node": "^10",
    "tsconfig-paths": "^4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "_moduleAliases": {
    "@modules/*": "./src/modules/*",
    "@config/*": "./src/config/*"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml,yaml}": "prettier --write"
  }
}
