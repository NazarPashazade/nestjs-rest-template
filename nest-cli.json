{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [
            ".dto.ts",
            "-input.ts",
            "-payload.ts",
            "-connection-types.ts",
            "page-info.ts"
          ],
          "classValidatorShim": true,
          "introspectComments": false
        }
      }
    ]
  }
}
