  "info": {
    "title": "nestjs-rest-template",
    "description": "REST API with JWT authentication. Log in via `POST /auth/login` and use **Authorize** with the returned `accessToken`.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RoleNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "RoleEdge": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/RoleNode"
          }
        },
        "required": [
          "node"
        ]
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          }
        },
        "required": [
          "page",
          "totalPages",
          "hasNextPage",
          "hasPreviousPage"
        ]
      },
      "RoleConnection": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "number"
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleEdge"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "totalCount",
          "edges",
          "pageInfo"
        ]
      },
      "UserNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
