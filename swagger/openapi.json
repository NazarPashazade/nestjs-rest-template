{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/roles": {
      "get": {
        "operationId": "RoleController_getRoles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleConnection"
                }
              }
            }
          }
        },
        "summary": "List roles",
        "tags": [
          "Roles"
        ]
      }
    },
    "/users": {
      "get": {
        "operationId": "UserController_getUsers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserConnection"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List users",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "UserController_getUserById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          }
        },
        "summary": "Get a user by id",
        "tags": [
          "Users"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthorizeUserController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginPayload"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, or the email is not verified"
          },
          "403": {
            "description": "Email or password is incorrect"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Log in and receive a JWT access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthorizeUserController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterPayload"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "An account with this email already exists"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Create an account and send a verification email",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/verify-email": {
      "post": {
        "operationId": "AuthorizeUserController_verifyEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailPayload"
                }
              }
            }
          },
          "400": {
            "description": "Token is invalid or has expired"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Verify an email with the token from the verification email",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/resend-verification": {
      "post": {
        "description": "Always returns 202, whether or not the email is registered.",
        "operationId": "AuthorizeUserController_resendVerification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendVerificationPayload"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Send the verification email again",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "description": "Always returns 202, whether or not the email is registered.",
        "operationId": "AuthorizeUserController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPasswordPayload"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Send a password reset email",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/reset-password": {
      "post": {
        "operationId": "AuthorizeUserController_resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPasswordPayload"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, or the token is invalid, expired or already used"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Set a new password with the token from the password reset email",
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "nestjs-rest-template",
    "description": "REST API with JWT authentication. Log in via `POST /auth/login` and use **Authorize** with the returned `accessToken`.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RoleNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "RoleEdge": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/RoleNode"
          }
        },
        "required": [
          "node"
        ]
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          }
        },
        "required": [
          "page",
          "totalPages",
          "hasNextPage",
          "hasPreviousPage"
        ]
      },
      "RoleConnection": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "number"
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleEdge"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "totalCount",
          "edges",
          "pageInfo"
        ]
      },
      "UserNode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UserEdge": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/UserNode"
          }
        },
        "required": [
          "node"
        ]
      },
      "UserConnection": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "number"
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserEdge"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "totalCount",
          "edges",
          "pageInfo"
        ]
      },
      "RoleDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "FileInfoDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "objectName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "extension": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "size",
          "extension",
          "createdAt",
          "updatedAt"
        ]
      },
      "UserDetailsDTO": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string"
          },
          "dateOfBirth": {
            "format": "date-time",
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE"
            ]
          },
          "bio": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "avatar": {
            "$ref": "#/components/schemas/FileInfoDTO"
          },
          "coverPhoto": {
            "$ref": "#/components/schemas/FileInfoDTO"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "phoneNumber",
          "createdAt",
          "updatedAt"
        ]
      },
      "UserDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/RoleDTO"
          },
          "details": {
            "$ref": "#/components/schemas/UserDetailsDTO"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "emailVerified",
          "role",
          "details",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "@dm1nP@ssL0CAL"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginPayload": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "RegisterInput": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "example": "Jane"
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "Str0ngPass!"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+994501234567"
          },
          "dateOfBirth": {
            "type": "string",
            "example": "1995-04-12"
          },
          "gender": {
            "enum": [
              "MALE",
              "FEMALE"
            ],
            "type": "string",
            "example": "FEMALE"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password",
          "phoneNumber"
        ]
      },
      "RegisterPayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified"
        ]
      },
      "VerifyEmailInput": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The `token` query parameter from the link in the verification email"
          }
        },
        "required": [
          "token"
        ]
      },
      "VerifyEmailPayload": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "ResendVerificationInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResendVerificationPayload": {
        "type": "object",
        "properties": {
          "sent": {
            "type": "boolean"
          }
        },
        "required": [
          "sent"
        ]
      },
      "ForgotPasswordInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordPayload": {
        "type": "object",
        "properties": {
          "sent": {
            "type": "boolean"
          }
        },
        "required": [
          "sent"
        ]
      },
      "ResetPasswordInput": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The `token` query parameter from the link in the password reset email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "example": "N3wStr0ngPass!"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ResetPasswordPayload": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      }
    }
  }
}
